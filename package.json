{
  "name": "thoughttree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first Thinking Tracker — Capture freely. Organize deliberately. Focus relentlessly.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:rust": "node scripts/run-rust.cjs test",
    "tauri": "tauri",
    "app:dev": "node scripts/run-rust.cjs dev",
    "app:build": "node scripts/run-rust.cjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.6",
    "vite": "^7",
    "vitest": "^3"
  }
}
